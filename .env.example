# How skills reach Bob: "shell" = IBM Bob Shell headless (official, recommended),
# "http" = direct HTTP (only for the local stand-in in devtools/mock_bob.py).
BOB_CLIENT=shell

# Bob API key: bob.ibm.com -> your subscription -> API keys. Never commit the real value.
BOB_API_KEY=your_bob_api_key_here

# --- Bob Shell (BOB_CLIENT=shell). Needs Node 22.15+ and: npm install -g bobshell
# Set to true only after reading and accepting the IBM license (bob --show-license).
BOB_ACCEPT_LICENSE=false
# BOB_TEAM_ID=                 # only for API keys of type "general"
# BOB_MAX_TURNS=30             # per skill run
# BOB_MAX_COST=                # per skill run, empty = no limit
# BOB_SHELL_TIMEOUT=900        # seconds per skill run
# BOB_DISABLED_TOOL_GROUPS=execute,browser,mcp,subagent
# BOB_SHELL_JS=                # path to bobshell's dist/bob.js if not auto-detected

# --- Direct HTTP (BOB_CLIENT=http), e.g. the stand-in:
# BOB_API_ENDPOINT=http://127.0.0.1:8765
# BOB_SKILLS_PATH=/inference/v1/skills/run

# --- Optional
# WORKSPACE_DIR=               # where repos are cloned (default: system temp folder/hackathon_workspaces)
# MAX_PARALLEL_SKILLS=3        # Bob runs at the same time
# CLONE_TIMEOUT=600
# LOCAL_TOOL_TIMEOUT=300
# CORS_ORIGINS=*
