BOB_API_KEY=your_bob_api_key_here
BOB_API_ENDPOINT=https://api.us-east.bob.ibm.com
# The skills path is NOT verified: confirm it with the official Bob API docs.
BOB_SKILLS_PATH=/inference/v1/skills/run
# BOB_TIMEOUT=300

# Optional
# WORKSPACE_DIR=              # where repos are cloned (default: system temp folder/hackathon_workspaces)
# MAX_PARALLEL_SKILLS=3       # Bob calls at the same time
# CLONE_TIMEOUT=600
# LOCAL_TOOL_TIMEOUT=300
# REPO_CONTEXT_MAX_CHARS=1000000
# REPO_FILE_MAX_CHARS=400000
# CORS_ORIGINS=*              # comma-separated dashboard origins, e.g. http://localhost:5173
