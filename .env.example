# RepoPilot / Model X - Bob settings. Put this file in your ModelXGit folder (next to main.py).
# PRIVATE environment variables file

BOB_CLIENT=shell
BOB_API_KEY=replace_your_api_key_here

# Read the IBM Bob Shell license first:  bob --show-license
# If you accept it, change false to true:
BOB_ACCEPT_LICENSE=true
